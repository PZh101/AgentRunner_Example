{
  "name": "@agent-runner/drivers",
  "version": "0.1.0",
  "description": "Execution engine drivers: claude_sdk, claude_cli, pi_agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agent-runner/core": "workspace:*",
    "@agent-runner/mcp-bridge": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@mariozechner/pi-ai": "^0.9.4",
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
